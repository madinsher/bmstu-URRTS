DEF R0 E-puck {
  translation -0.5699 -0.8173 0
  rotation 0 0 1 2.4527
  name "e-puck 0"
  controller "urrts_epuck"
  controllerArgs [ "id=0" "mode=coverage" "arena=-1,1,-1,1" "rsense=0.5" "focus=0.4,0.4,0.35" "radio=1.0" "vmax=0.1" "stale=0.5" "gain=1.0" ]
  turretSlot [
    GPS { name "gps" }
    InertialUnit { name "imu" }
    Emitter { name "radio_tx" type "radio" range 1.0 channel 5 }
    Receiver { name "radio_rx" type "radio" channel 5 }
    Receiver { name "cmd_rx" type "radio" channel 6 }
  ]
}
