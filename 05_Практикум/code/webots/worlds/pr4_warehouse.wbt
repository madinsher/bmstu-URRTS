DEF R0 E-puck {
  translation 0.3750 -0.2500 0
  rotation 0 0 1 0.0000
  name "e-puck 0"
  controller "urrts_epuck"
  controllerArgs [ "id=0" "mode=mapf" "plan=../../plans/pr4_warehouse.json" "radio=5.0" "vmax=0.1" ]
  turretSlot [
    GPS { name "gps" }
    InertialUnit { name "imu" }
    Emitter { name "radio_tx" type "radio" range 5.0 channel 5 }
    Receiver { name "radio_rx" type "radio" channel 5 }
    Receiver { name "cmd_rx" type "radio" channel 6 }
  ]
}
