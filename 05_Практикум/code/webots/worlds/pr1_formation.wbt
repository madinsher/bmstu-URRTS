}
DEF R0 E-puck {
  translation 0.4289 -0.5597 0
  rotation 0 0 1 0.7250
  name "e-puck 0"
  controller "urrts_epuck"
  controllerArgs [ "id=0" "mode=formation" "n=6" "shape=hexagon" "size=0.2" "radio=0.7" "vmax=0.1" "stale=0.5" ]
  turretSlot [
    GPS { name "gps" }
    InertialUnit { name "imu" }
    Emitter { name "radio_tx" type "radio" range 0.7 channel 5 }
    Receiver { name "radio_rx" type "radio" channel 5 }
    Receiver { name "cmd_rx" type "radio" channel 6 }
  ]
}
